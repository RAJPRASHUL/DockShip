[Unit]
Description=DockShip control plane
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=dockship
WorkingDirectory=/opt/dockship
EnvironmentFile=/opt/dockship/.env
ExecStart=/opt/dockship/.venv/bin/uvicorn dockship.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
